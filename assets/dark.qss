QWidget { color: #e3ebf6; font-family: "Noto Sans"; font-size: 12px; }
QMainWindow, QWidget#homePage, QWidget#dashboardBody, QDialog { background: #161e2a; }
QFrame#sidebar { background: #202b3b; border-right: 1px solid #35445a; }
QLabel { background: transparent; }
QLabel#brandName { font-size: 17px; font-weight: 700; }
QLabel#heroTitle, QLabel#templateTitle { font-size: 28px; font-weight: 700; }
QLabel#sectionLabel { font-size: 9px; color: #9daec5; font-weight: 600; }
QLabel#mutedText, QLabel#privacyText { font-size: 11px; color: #9daec5; }
QLabel#privacyText { padding-top: 14px; }
QLabel#emptyState { background: #202b3b; border: 1px dashed #35445a; padding: 24px; color: #9daec5; }
QPushButton { background: #202b3b; border: 1px solid #35445a; padding: 9px 12px; border-radius: 5px; }
QPushButton:hover { background: #293b55; border-color: #8bb6ff; }
QPushButton:pressed { background: #304c77; }
QPushButton:focus { border-color: #8bb6ff; }
QPushButton:disabled { color: #9daec5; }
QPushButton#navButton, QPushButton#locationButton { background: transparent; text-align: left; padding: 10px; border: 0; }
QPushButton#navButton:hover, QPushButton#locationButton:hover { background: #293b55; }
QPushButton#navButton:checked { background: #304c77; color: #8bb6ff; font-weight: 600; }
QPushButton#primaryButton { background: #245fcc; color: white; border: 1px solid #245fcc; padding: 11px 18px; font-weight: 600; }
QPushButton#primaryButton:hover { background: #174ba9; }
QPushButton#resumeButton { background: #233a59; text-align: left; border: 1px solid #35445a; padding: 14px 18px; color: #e3ebf6; }
QPushButton#toolCard { text-align: left; padding: 12px 18px; }
QPushButton#templateCard { background: #202b3b; border: 1px solid #35445a; padding: 0; }
QPushButton#templateCard:hover { background: #293b55; border-color: #8bb6ff; }
QLabel#cardHeading { font-size: 14px; font-weight: 600; }
QLabel#templateSymbol { font-size: 26px; color: #8bb6ff; }
QLineEdit, QSpinBox, QComboBox { padding: 7px; background: #202b3b; border: 1px solid #35445a; border-radius: 4px; color: #e3ebf6; selection-background-color: #304c77; }
QLineEdit:focus { border-color: #8bb6ff; }
QLineEdit#librarySearch { padding: 10px 12px; }
QComboBox QAbstractItemView { background: #202b3b; color: #e3ebf6; selection-background-color: #304c77; }
QTreeWidget, QListWidget { background: #202b3b; color: #e3ebf6; border: 1px solid #35445a; alternate-background-color: #1b2635; outline: 0; }
QTreeWidget#documentList::item { padding: 12px 8px; border-bottom: 1px solid #35445a; }
QTreeWidget::item:selected, QListWidget::item:selected { background: #304c77; color: #e3ebf6; }
QTreeWidget::item:hover, QListWidget::item:hover { background: #293b55; }
QListWidget::item { padding: 8px; }
QHeaderView::section { background: #1b2635; color: #9daec5; font-size: 10px; border: 0; border-bottom: 1px solid #35445a; padding: 10px 8px; text-align: left; }
QToolBar { background: #202b3b; padding: 6px; spacing: 4px; border-bottom: 1px solid #35445a; }
QToolButton { background: transparent; color: #e3ebf6; border: 0; padding: 7px; border-radius: 3px; }
QToolButton:hover, QToolButton:checked { background: #304c77; }
QMenuBar, QMenu, QStatusBar { background: #202b3b; color: #e3ebf6; }
QMenuBar::item { padding: 6px 10px; }
QMenuBar::item:selected, QMenu::item:selected { background: #304c77; }
QMenu::item { padding: 7px 24px; }
QMenu { border: 1px solid #35445a; }
QStatusBar { border-top: 1px solid #35445a; font-size: 10px; }
QTabWidget::pane { border: 1px solid #35445a; }
QTabBar::tab { padding: 9px 15px; background: #1b2635; color: #9daec5; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { background: #202b3b; color: #8bb6ff; border-bottom: 2px solid #8bb6ff; }
QDockWidget { color: #e3ebf6; background: #161e2a; }
QDockWidget::title { padding: 7px; background: #1b2635; }
QScrollArea { border: 0; background: #161e2a; }
QProgressBar { border: 0; background: #1b2635; height: 5px; }
QProgressBar::chunk { background: #245fcc; }
QCheckBox { spacing: 8px; }
